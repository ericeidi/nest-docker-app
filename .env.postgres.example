# Variáveis injetadas SOMENTE no container do PostgreSQL (env_file do serviço postgres).
# Usadas só na PRIMEIRA criação do volume.

# Administrador (superuser). Uso apenas manual/manutenção — a API NUNCA usa este usuário.
# Senha: Docker secret secrets/postgres_admin_password.txt (POSTGRES_PASSWORD_FILE).
POSTGRES_USER=postgres_admin
POSTGRES_DB=nest_app_db

# Role da aplicação, criada sem superuser por docker/postgres/init/01-criar-role-app.sh.
# Deve bater com DB_USER do .env.api. Senha: secrets/db_password.txt (APP_DB_PASSWORD_FILE).
APP_DB_USER=nest_app
