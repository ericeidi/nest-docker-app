# Variáveis injetadas SOMENTE no container do PostgreSQL (env_file do serviço postgres).
# Usadas só na PRIMEIRA criação do volume. Devem bater com DB_USER/DB_NAME do .env.api.
# A senha NÃO fica aqui: vem do Docker secret secrets/db_password.txt (POSTGRES_PASSWORD_FILE).
POSTGRES_USER=nest_app
POSTGRES_DB=nest_app_db
