# Dependências e build
node_modules/
dist/
coverage/
*.tsbuildinfo

# Variáveis de ambiente (contêm segredos) — só o template é versionado
.env
.env.*
!.env.example
!.env.*.example

# Backups do banco
backups/

# Logs e sistema
*.log
npm-debug.log*
.DS_Store

# IDEs
.idea/
.vscode/

# Docker secrets (só os .example são versionados)
secrets/*
!secrets/*.example

# Terraform (state contém senhas geradas; tfvars contém IDs da conta)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log
