# Variáveis injetadas SOMENTE no container da API (env_file do serviço api).

# Ambiente da aplicação
NODE_ENV=production

# Porta interna do Nest. Mantenha 3000 — é a porta mapeada no docker-compose.
# Para mudar a porta na sua máquina, altere HOST_PORT no .env.
PORT=3000

# Nome da aplicação (exemplo de variável lida via ConfigService)
APP_NAME=nest-docker-app

# ---------- Conexão com o PostgreSQL ----------
# Nome do SERVIÇO no docker-compose (DNS interno da rede Docker). Nunca "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_USER=nest_app
# Senha: Docker secret secrets/db_password.txt (DB_PASSWORD_FILE no compose)
DB_NAME=nest_app_db

# ---------- Segurança HTTP ----------
# Origens liberadas para CORS, separadas por vírgula. Vazio = nenhuma origem externa.
CORS_ORIGINS=
# Rate limiting: no máximo THROTTLE_LIMIT requisições por IP a cada THROTTLE_TTL_MS.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
