# Variáveis injetadas SOMENTE no container da API (env_file do serviço api).

# Ambiente da aplicação
NODE_ENV=production

# Porta interna do Nest. Mantenha 3000 — é a porta mapeada no docker-compose.
# Para mudar a porta na sua máquina, altere HOST_PORT no .env.
PORT=3000

# Nome da aplicação (exemplo de variável lida via ConfigService)
APP_NAME=nest-docker-app

# ---------- Conexão com o PostgreSQL ----------
# Nome do SERVIÇO no docker-compose (DNS interno da rede Docker). Nunca "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_USER=nest_app
# Senha: Docker secret secrets/db_password.txt (DB_PASSWORD_FILE no compose)
DB_NAME=nest_app_db
# Máximo de conexões do pool por instância (default 10)
DB_POOL_MAX=10

# ---------- Segurança HTTP ----------
# Origens liberadas para CORS, separadas por vírgula. Vazio = nenhuma origem externa.
CORS_ORIGINS=
# Rate limiting: no máximo THROTTLE_LIMIT requisições por IP a cada THROTTLE_TTL_MS.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ---------- Mensageria (outbox + Pub/Sub) ----------
# No docker compose estas variáveis vêm do próprio docker-compose.yml (x-ambiente-app).
# Defina aqui só para rodar fora do compose (npm run start:dev).
# Papel do processo: api (padrão) ou worker. Lido do ambiente ANTES do Nest subir,
# então no start:dev passe na linha de comando: MODO_APP=worker npm run start:dev
# MODO_APP=api
# Emulador local do Pub/Sub. Sem ela, o client usa o Pub/Sub real do projeto.
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJETO_ID=nest-local
PUBSUB_TOPICO_EVENTOS=eventos-app
# continuo = loop de polling (processo sempre ligado) | sob-demanda = Cloud Run (cpu_idle)
OUTBOX_RELAY_MODO=continuo
# true só em testes/desenvolvimento; em produção as migrations rodam no job migrar-outbox
OUTBOX_MIGRAR_NA_INICIALIZACAO=false
# Rota pública POST /demo/tarefas (demonstração). Nunca ligue em produção.
DEMO_MENSAGERIA_HABILITADA=false
