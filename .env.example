# Ambiente da aplicação
NODE_ENV=production

# Porta em que o Nest escuta DENTRO do container
PORT=3000

# Porta exposta na sua máquina (http://localhost:HOST_PORT)
HOST_PORT=3000

# Nome da aplicação (exemplo de variável lida via ConfigService)
APP_NAME=nest-docker-app

# ---------- Conexão da API com o PostgreSQL ----------
# Nome do SERVIÇO no docker-compose (DNS interno da rede Docker). Nunca "localhost".
DB_HOST=postgres
DB_PORT=5432
DB_USER=nest_app
DB_PASSWORD=troque-me
DB_NAME=nest_app_db

# ---------- Inicialização do container Postgres ----------
# Usados só na PRIMEIRA criação do volume. Devem bater com DB_USER/DB_PASSWORD/DB_NAME.
POSTGRES_USER=nest_app
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=nest_app_db
